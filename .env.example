# ─────────────────────────────────────────────────────────────
# 환경변수 템플릿 — process.md 4.10 시크릿
#
#   이 파일은 커밋한다.        키 "이름"만 담고 값은 비운다.
#   .env 는 커밋하지 않는다.   .gitignore로 제외됨.
#   배포 환경에서는 파일이 아니라 플랫폼 환경변수 UI에 넣는다.
#
# 사용법
#   cp .env.example .env   그리고 .env에만 실제 값을 채운다.
#
# ⚠️ git에 시크릿을 한 번 커밋하면 지우는 커밋을 올려도 히스토리에 영구히 남는다.
#    유일한 대응은 그 키를 폐기하고 새로 발급(rotate)하는 것이다.
#
# 스택: Java 25 LTS / Spring Boot 4.1 / Gradle / PostgreSQL  (process.md 6.1)
# 자바 설정에서는 application.yml에 ${KEY} 로 참조한다. 하드코딩 금지(4.10).
# ─────────────────────────────────────────────────────────────

# ── 데이터베이스 (ADR-003 PostgreSQL) ─────────────────────────
# 로컬은 Docker Compose가 띄운 Postgres를 가리킨다.
# 통합 테스트는 이 값을 쓰지 않는다 — Testcontainers가 컨테이너를 띄우고
# 접속 정보를 런타임에 주입한다(test-strategy.md 5.1).
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ── 인증 (ADR-001 JWT Access + Refresh) ──────────────────────
# 서명 키. 이것이 유출되면 누구나 유효한 티켓을 위조할 수 있다.
# JWT는 암호화가 아니라 서명이다 — 내용은 누구나 읽을 수 있고 이 키가 막는 것은 "위조"뿐이다.
#   → learning/ 의 서명 개념 노트 참조
# 충분히 길고 무작위여야 한다. 사람이 지어낸 문자열을 쓰지 않는다.
JWT_SECRET=

# ── 관리자 초기 계정 (spec.md FR-023) ────────────────────────
# ⚠️ 소스 저장소에 어떤 형태로도 남지 않아야 한다 — 해시된 값도 포함.
#    저장소가 공개이기 때문이다(constitution 원칙 VII).
# 초기화는 여러 번 실행해도 안전해야 한다(멱등).
ADMIN_INITIAL_ID=
ADMIN_INITIAL_PASSWORD=

# ── 자격증명 수명 (4번 plan 확정 — research.md 4) ─────────────
# spec.md Assumptions 1의 가정값을 그대로 확정했다.
# 실무 범위(Access 15분~1시간, Refresh 7~30일) 안에 있다.
#
#   확정값        Access   Refresh
#   사용자         30분      14일
#   관리자         15분       1일     ← FR-033 · AC-33: 관리자가 반드시 더 짧다
#
# ⚠️ AC-33은 "관리자가 더 짧다"는 관계만 요구한다. 값을 바꿀 때 그 관계를 깨지 않는다
#    — 깨면 AC-33이 실패한다.
# 값을 여기에 적지 않는 이유는 4.10이다. 확정값은 위 주석과 research.md 4에 있다.
USER_ACCESS_TTL=
USER_REFRESH_TTL=
ADMIN_ACCESS_TTL=
ADMIN_REFRESH_TTL=

# ── 남용 방어 임계값 (4번 plan 확정 — research.md 6) ──────────
# FR-027 · AC-29 점진적 지연. 계정 단위 카운터.
# 계정을 잠그지 않는다(FR-027 MUST NOT) — 차단 시간이 지나면 정상 로그인된다.
#
#   확정값
#     AUTH_FAIL_DELAY_THRESHOLD   3      이 횟수부터 지연을 시작한다 (1~2회는 지연 없음)
#     AUTH_FAIL_BLOCK_THRESHOLD   6      이 횟수부터 429 AUTH_TOO_MANY_ATTEMPTS
#     AUTH_FAIL_BLOCK_DURATION    60초   429 상태를 유지하는 시간
#     AUTH_FAIL_WINDOW            15분   카운터 유효 기간. 로그인 성공 시 즉시 초기화
#
# ⚠️ 지연은 스레드를 붙잡는 방식으로 구현하면 방어 장치가 서비스 거부 수단이 된다.
#    가상 스레드를 켠다(spring.threads.virtual.enabled) — research.md 6의 함정.
AUTH_FAIL_DELAY_THRESHOLD=
AUTH_FAIL_BLOCK_THRESHOLD=
AUTH_FAIL_BLOCK_DURATION=
AUTH_FAIL_WINDOW=

# FR-030 · AC-30 중복확인 빈도 제한. 클라이언트 단위 카운터.
# 중복확인은 설계상 아이디 존재 여부를 그대로 알려주므로 제한이 필수다.
#
#   확정값  CHECK_ID_RATE_LIMIT_PER_MINUTE = 10  (분당 허용 횟수, 초과 시 429)
#
# ⚠️ 회사·학교처럼 출처 주소를 공유하는 환경에서는 카운터도 공유된다.
#    그래서 임계값을 너무 낮추지 않았다 — research.md 6의 받아들인 대가.
CHECK_ID_RATE_LIMIT_PER_MINUTE=

# ── 키가 없는 이유가 있는 것 ──────────────────────────────────
# 실패 횟수 저장 위치: 설정 대상이 아니다. 서버 메모리로 확정했고(research.md 5)
#   서버 1대가 전제다. 고를 대안이 없으므로 키를 두지 않는다.
#   방아쇠: 서버가 2대 이상이 되는 시점 — 그때 공유 저장소 접속 키가 필요해진다.
#
# 만료된 티켓 청소 주기: 하루 1회로 확정(data-model.md 물리 설계 5절). 운영자가
#   조절할 이유가 없어 설정으로 빼지 않는다. 바뀌면 코드와 문서를 함께 고친다.
#
# 호스팅 관련 키(로그 수집·오브젝트 스토리지 등)는 process.md 6.2의 방아쇠가
#   당겨질 때 추가한다. 지금은 로컬만 있으므로 필요 없다.
